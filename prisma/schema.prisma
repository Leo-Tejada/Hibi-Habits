// Hibi Habits — data model.
//
// The pyramid, top to bottom:
//   Category > Subcategory > Habit > Quest > Task
//
// Category and Subcategory are the philosophy of the app and are never
// editable, so they are not tables. A habit carries the area it serves.
// A quest attached to a habit belongs to that habit's area, so it stores
// none; only a loose quest stores a `subcategory` of its own. Storing it
// on both would let them drift apart, and they can't.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The nine areas of life. Fixed forever — see the note above.
enum Subcategory {
  MIND
  BODY
  SPIRIT
  LOVE
  FAMILY
  FRIENDS
  WORK
  GROWTH
  MONEY
}

/// Main quests are the three anchors of a season, one per category.
/// Side quests are optional and unlimited.
enum QuestKind {
  MAIN
  SIDE
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

/// How a habit decides which days it wants a task on.
enum ScheduleKind {
  /// Fixed weekdays, e.g. every Monday and Thursday.
  WEEKLY_DAYS
  /// A fixed cadence counted from the habit's anchor date, e.g. every 3 days.
  EVERY_N_DAYS
}

/// There is no "skipped". Unchecked is unchecked, whatever the reason —
/// so the numbers cannot be softened by generous self-reporting.
enum TaskStatus {
  PENDING
  DONE
}

model User {
  id        String   @id @default(cuid())
  name      String
  /// IANA zone. Decides when "today" rolls over for this user.
  timeZone  String   @default("UTC")
  createdAt DateTime @default(now())

  seasons  Season[]
  quests   Quest[]
  habits   Habit[]
  tasks    Task[]
  journal  JournalEntry[]

  @@map("users")
}

/// One calendar quarter of living. A season always begins on the 1st of
/// January, April, July or October, so which season a day belongs to is
/// arithmetic rather than a lookup — see `src/lib/seasons/quarter.ts`.
///
/// Everything a season owns dies with it except habits, which are meant
/// to outlive the quest that started them.
model Season {
  id       String   @id @default(cuid())
  userId   String
  /// Human-facing name, e.g. "Autumn 2026". The quarter label is derived.
  name     String
  /// Must be a quarter boundary. Identifies the season on its own.
  startsOn DateTime @db.Date
  /// Inclusive last day. Derived on write so date queries stay simple.
  endsOn   DateTime @db.Date

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests     Quest[]
  reflection SeasonReflection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, startsOn])
  @@map("seasons")
}

/// What a season is for. A quest is served by a habit — the practice
/// that earns it — or hangs loose when no single habit serves it.
/// Progress is self-rated: the user sets it, nothing derives it.
model Quest {
  id          String      @id @default(cuid())
  userId      String
  seasonId    String
  /// The habit that serves this quest. Null means a loose quest.
  habitId     String?
  kind        QuestKind
  /// Only loose quests carry an area; an attached quest belongs to its
  /// habit's area (see the note at the top of this file).
  subcategory Subcategory?
  title       String
  intent      String?
  /// 0–100, set by hand. See `src/lib/quests/rules.ts`.
  progress    Int         @default(0)
  status      QuestStatus @default(ACTIVE)
  sortOrder   Int         @default(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  habit  Habit?  @relation(fields: [habitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seasonId, kind])
  @@index([userId, status])
  @@index([habitId])
  @@map("quests")
}

/// A repeating practice. A schedule makes a missed task detectable:
/// without an expected day, nothing can be late. A habit without one
/// wants no day at all — it exists as a practice and a suggestion.
model Habit {
  id          String      @id @default(cuid())
  userId      String
  subcategory Subcategory
  title       String

  scheduleKind ScheduleKind
  /// WEEKLY_DAYS only. 0 = Sunday through 6 = Saturday. Empty means the
  /// habit wants no day: it never generates tasks, it only suggests
  /// itself in the daily composer.
  weekdays     Int[]        @default([])
  /// EVERY_N_DAYS only. Counted from `anchorOn`.
  intervalDays Int?
  /// Day the cadence starts counting from.
  anchorOn     DateTime     @db.Date

  /// Names cycled through on successive occurrences, so a Monday and
  /// Thursday habit called "Calisthenics" can produce Push then Pull.
  /// Empty means every occurrence is just the habit's own name.
  rotation     String[]     @default([])

  /// Default clock time for generated tasks, as minutes past midnight.
  startMinute  Int?
  endMinute    Int?

  /// Optional measurement, e.g. "reps" with a target of 30.
  unit   String?
  target Float?

  archivedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  quests Quest[]
  tasks  Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, archivedAt])
  @@map("habits")
}

/// One thing to do on one day. The only level the user touches daily.
///
/// A task hangs off a habit — the practice it serves — or off nothing at
/// all: a stray errand that counts toward no statistic.
model Task {
  id      String     @id @default(cuid())
  userId  String
  habitId String?
  /// The part after the dot: "Push" in `Calisthenics.Push`. For a task
  /// with no habit this is the whole name. Empty means the habit's own
  /// name says everything.
  title   String
  dueOn   DateTime   @db.Date
  status  TaskStatus @default(PENDING)

  /// Minutes past midnight. Both optional: plenty of tasks have no clock.
  startMinute Int?
  endMinute   Int?

  /// Manual order among the tasks of a day. Timed tasks sort by the
  /// clock instead, but an untimed task holds wherever it was dragged.
  sortOrder   Int        @default(0)

  /// Written by a habit's schedule rather than typed. Generated lines are
  /// locked in the editor so a stray keystroke cannot break the link.
  generated   Boolean    @default(false)

  completedAt DateTime?
  /// Snapshots of the habit's measurement at the time the task was made,
  /// so re-tuning a habit never rewrites history.
  value       Float?
  unit        String?
  target      Float?
  note        String?

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit? @relation(fields: [habitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Deliberately not unique. A habit may legitimately appear twice on
  /// one day — a second session, or a manual `Calisthenics.Pull` beside
  /// the generated `Calisthenics.Push`. Idempotent generation is the
  /// generator's job, not a constraint that forbids you writing things.
  @@index([habitId, dueOn])
  @@index([userId, dueOn])
  @@map("tasks")
}

/// One page per day: the writing and the mood live together because
/// they are written together.
model JournalEntry {
  id      String   @id @default(cuid())
  userId  String
  entryOn DateTime @db.Date

  /// 1–5, low to high.
  mood      Int?
  energy    Int?
  body      String?
  gratitude String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, entryOn])
  @@index([userId, entryOn])
  @@map("journal_entries")
}

/// The closing ceremony of a season.
model SeasonReflection {
  id       String @id @default(cuid())
  seasonId String @unique

  wentWell     String?
  wentBadly    String?
  learned      String?
  carryForward String?
  /// Set when the user finishes the form. Null means started, not done.
  completedAt  DateTime?

  season  Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  ratings SeasonRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("season_reflections")
}

/// How the season went in one area of life, scored by hand at the end.
model SeasonRating {
  id           String      @id @default(cuid())
  reflectionId String
  subcategory  Subcategory
  /// 1–5.
  score        Int
  note         String?

  reflection SeasonReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)

  @@unique([reflectionId, subcategory])
  @@map("season_ratings")
}
